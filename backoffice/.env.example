APP_NAME="Global EcoAction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.globalecoaction.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=geca_admin_session
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
# Bluehost : /home2/fnksrwmy/public_html/geca-admin
# Laisser vide en local pour utiliser backoffice/public.
GECA_PUBLIC_PATH=null

# Activer seulement après validation de GD côté HTTP et des essais de fichiers.
GECA_MEDIA_UPLOADS_ENABLED=false

# Lien public affiché dans le menu de l’administration.
GECA_PUBLIC_SITE_URL=https://globalecoaction.org

# Newsletter interne : preview = simulation privée sans envoi.
GECA_NEWSLETTER_MODE=preview
GECA_NEWSLETTER_ORIGINS=https://globalecoaction.org,https://gaslandie.github.io
GECA_NEWSLETTER_FROM=
GECA_NEWSLETTER_HOURLY_LIMIT=30
# Pour SMTP, configurer MAIL_HOST/PORT/USERNAME/PASSWORD/SCHEME séparément.
