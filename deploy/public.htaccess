# GECA : site public statique, distinct de l’administration Laravel.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Préserver les validations de certificat existantes.
RewriteRule ^\.well-known/ - [L]
# Domaine de destination fixé, sans utiliser un Host fourni par le visiteur.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^globalecoaction\.org$ [NC]
RewriteRule ^ https://globalecoaction.org%{REQUEST_URI} [R=301,L]
# Accueil français permanent : même destination que la canonique et le sitemap.
RewriteRule ^$ /fr/ [R=301,L]
# Le serveur public ne comporte aucun point d’entrée d’administration ou d’envoi.
RewriteRule ^(?:administration|connexion|newsletter|api)(?:/|$) - [R=404,L]
RewriteRule (^|/)\. - [R=404,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  Header always unset X-Powered-By

  # Pages et URL non versionnées : validation auprès du serveur à chaque visite.
  # Erreurs/refus : ne pas conserver une réponse qui pourrait changer.
  Header onsuccess unset Cache-Control
  Header always set Cache-Control "no-store"
  Header always set Cache-Control "no-cache" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
  # Les noms des variantes et les sorties Next changent à chaque changement de contenu.
  <If "%{REQUEST_URI} =~ m#^/(?:images/optimized/[a-zA-Z0-9_-]+-[0-9a-f]{12}\.webp|_next/static/[^?]+\.(?:js|css|woff2?|ttf))$#">
    Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
  </If>
</IfModule>

<FilesMatch "\.(?:php|phar|sqlite|sql|log|bak|zip|gz|map)$">
  Require all denied
</FilesMatch>
